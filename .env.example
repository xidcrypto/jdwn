# URL publik situs. Dipakai untuk metadata SEO, canonical, robots.txt, dan sitemap.
NEXT_PUBLIC_SITE_URL="https://hgitopup.web.id"

# Database (SQLite). Ubah path bila perlu.
DATABASE_URL="file:./data.db"

# Secret untuk penandatanganan sesi & signed link. Ganti dengan string acak >= 32 karakter.
JWT_SECRET="change-this-secret-in-production-min-32-chars"

# Daftar origin tambahan yang diizinkan memanggil API (dipisah koma).
# Biasanya tidak perlu karena origin diambil otomatis dari Host/nama domain.
# Contoh: ALLOWED_ORIGINS="https://hgitopup.web.id,http://localhost:3000"
ALLOWED_ORIGINS=""

# Set "1" hanya jika ingin mengizinkan request API tanpa Origin/Referer
# (mis. untuk testing dengan curl / integrasi server-to-server). Default: ditolak.
API_ALLOW_NO_ORIGIN=""

# Kustomisasi Content-Security-Policy (opsional).
# CSP_POLICY="default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https:"
